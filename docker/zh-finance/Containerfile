FROM buyicoder/erpnext-cn:v16.32.3

ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}"

USER root
COPY --chown=frappe:frappe erpnext/locale/zh.po /home/frappe/frappe-bench/apps/erpnext/erpnext/locale/zh.po
COPY --chown=frappe:frappe erpnext/public/js/erpnext.bundle.js /home/frappe/frappe-bench/apps/erpnext/erpnext/public/js/erpnext.bundle.js
COPY --chown=frappe:frappe erpnext/public/js/zh_finance_overrides.js /home/frappe/frappe-bench/apps/erpnext/erpnext/public/js/zh_finance_overrides.js
COPY --chown=frappe:frappe erpnext/public/js/zh_finance_format.mjs /home/frappe/frappe-bench/apps/erpnext/erpnext/public/js/zh_finance_format.mjs
COPY --chown=frappe:frappe erpnext/accounts/report/accounts_receivable/accounts_receivable.js /home/frappe/frappe-bench/apps/erpnext/erpnext/accounts/report/accounts_receivable/accounts_receivable.js
COPY --chown=frappe:frappe erpnext/projects/doctype/project/project.py /home/frappe/frappe-bench/apps/erpnext/erpnext/projects/doctype/project/project.py
COPY --chown=frappe:frappe erpnext/stock/doctype/item/item.json /home/frappe/frappe-bench/apps/erpnext/erpnext/stock/doctype/item/item.json

USER frappe
RUN cd /home/frappe/frappe-bench && \
	bench compile-po-to-mo --app erpnext --locale zh --force && \
	bench build --app erpnext && \
	js_bundle="$(basename "$(find assets/erpnext/dist/js -name 'erpnext.bundle.*.js' -type f | head -1)")" && \
	sed -i -E \
		"s#erpnext/dist/js/erpnext\\.bundle\\.[A-Z0-9_-]+\\.js#erpnext/dist/js/${js_bundle}#" \
		assets/assets.json && \
	mkdir -p assets/locale/zh/LC_MESSAGES && \
	cp sites/assets/locale/zh/LC_MESSAGES/erpnext.mo assets/locale/zh/LC_MESSAGES/erpnext.mo
