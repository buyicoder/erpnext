FROM node:22-bookworm-slim AS banking-builder

WORKDIR /workspace
RUN corepack enable
COPY banking/package.json banking/yarn.lock ./
RUN yarn install --frozen-lockfile
COPY banking/ ./
RUN yarn test:localization && mkdir -p /erpnext/www && yarn build

