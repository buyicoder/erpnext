FROM buyicoder/erpnext-cn:v16.32.3

ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}"

USER root
COPY --chown=frappe:frappe erpnext/locale/zh.po /home/frappe/frappe-bench/apps/erpnext/erpnext/locale/zh.po
COPY --chown=frappe:frappe erpnext/hooks.py /home/frappe/frappe-bench/apps/erpnext/erpnext/hooks.py
COPY --chown=frappe:frappe .build/frappe-v16.24.4-zh.po /tmp/frappe-zh-baseline.po
COPY --chown=frappe:frappe localization/frappe/zh.po /tmp/frappe-zh-overrides.po
COPY --chown=frappe:frappe localization/frappe/realtime_utils.js /home/frappe/frappe-bench/apps/frappe/realtime/utils.js
COPY --chown=frappe:frappe scripts/merge_frappe_zh_catalog.py /tmp/merge_frappe_zh_catalog.py
COPY --chown=frappe:frappe erpnext/public/js/erpnext.bundle.js /home/frappe/frappe-bench/apps/erpnext/erpnext/public/js/erpnext.bundle.js
COPY --chown=frappe:frappe erpnext/public/js/zh_finance_overrides.js /home/frappe/frappe-bench/apps/erpnext/erpnext/public/js/zh_finance_overrides.js
COPY --chown=frappe:frappe erpnext/public/js/zh_finance_format.mjs /home/frappe/frappe-bench/apps/erpnext/erpnext/public/js/zh_finance_format.mjs
COPY --chown=frappe:frappe erpnext/accounts/report/accounts_receivable/accounts_receivable.js /home/frappe/frappe-bench/apps/erpnext/erpnext/accounts/report/accounts_receivable/accounts_receivable.js
COPY --chown=frappe:frappe erpnext/accounts/doctype/journal_entry/journal_entry.py /home/frappe/frappe-bench/apps/erpnext/erpnext/accounts/doctype/journal_entry/journal_entry.py
COPY --chown=frappe:frappe erpnext/accounts/doctype/payment_entry/payment_entry.py /home/frappe/frappe-bench/apps/erpnext/erpnext/accounts/doctype/payment_entry/payment_entry.py
COPY --chown=frappe:frappe erpnext/accounts/print_format/pos_invoice_with_item_image/pos_invoice_with_item_image.json /home/frappe/frappe-bench/apps/erpnext/erpnext/accounts/print_format/pos_invoice_with_item_image/pos_invoice_with_item_image.json
COPY --chown=frappe:frappe erpnext/accounts/print_format/sales_invoice_with_item_image/sales_invoice_with_item_image.json /home/frappe/frappe-bench/apps/erpnext/erpnext/accounts/print_format/sales_invoice_with_item_image/sales_invoice_with_item_image.json
COPY --chown=frappe:frappe erpnext/accounts/print_format/cheque_printing_format/cheque_printing_format.json /home/frappe/frappe-bench/apps/erpnext/erpnext/accounts/print_format/cheque_printing_format/cheque_printing_format.json
COPY --chown=frappe:frappe erpnext/controllers/buying_controller.py /home/frappe/frappe-bench/apps/erpnext/erpnext/controllers/buying_controller.py
COPY --chown=frappe:frappe erpnext/controllers/selling_controller.py /home/frappe/frappe-bench/apps/erpnext/erpnext/controllers/selling_controller.py
COPY --chown=frappe:frappe erpnext/setup/china_money.py /home/frappe/frappe-bench/apps/erpnext/erpnext/setup/china_money.py
COPY --chown=frappe:frappe erpnext/projects/doctype/project/project.py /home/frappe/frappe-bench/apps/erpnext/erpnext/projects/doctype/project/project.py
COPY --chown=frappe:frappe erpnext/stock/doctype/item/item.json /home/frappe/frappe-bench/apps/erpnext/erpnext/stock/doctype/item/item.json
COPY --chown=frappe:frappe erpnext/setup/china_defaults.py /home/frappe/frappe-bench/apps/erpnext/erpnext/setup/china_defaults.py
COPY --chown=frappe:frappe erpnext/setup/setup_wizard/operations/defaults_setup.py /home/frappe/frappe-bench/apps/erpnext/erpnext/setup/setup_wizard/operations/defaults_setup.py
RUN sed -i \
	's#proxy_set_header Origin \$proxy_x_forwarded_proto://${FRAPPE_SITE_NAME_HEADER};#proxy_set_header Origin \$frappe_socket_origin;#' \
	/templates/nginx/frappe.conf.template && \
	sed -i \
	'/^server {/i map $http_origin $frappe_socket_origin {\n\tdefault $http_origin;\n\t"" $scheme://$http_host;\n}\n' \
	/templates/nginx/frappe.conf.template

USER frappe
RUN /home/frappe/frappe-bench/env/bin/python /tmp/merge_frappe_zh_catalog.py \
		--baseline /tmp/frappe-zh-baseline.po \
		--overrides /tmp/frappe-zh-overrides.po \
		--output /home/frappe/frappe-bench/apps/frappe/frappe/locale/zh.po && \
	cd /home/frappe/frappe-bench && \
	bench compile-po-to-mo --app frappe --locale zh --force && \
	bench compile-po-to-mo --app erpnext --locale zh --force && \
	bench build --app erpnext && \
	js_bundle="$(basename "$(find assets/erpnext/dist/js -name 'erpnext.bundle.*.js' -type f | head -1)")" && \
	sed -i -E \
		"s#erpnext/dist/js/erpnext\\.bundle\\.[A-Z0-9_-]+\\.js#erpnext/dist/js/${js_bundle}#" \
		assets/assets.json && \
	mkdir -p assets/locale/zh/LC_MESSAGES && \
	cp sites/assets/locale/zh/LC_MESSAGES/frappe.mo assets/locale/zh/LC_MESSAGES/frappe.mo && \
	cp sites/assets/locale/zh/LC_MESSAGES/erpnext.mo assets/locale/zh/LC_MESSAGES/erpnext.mo
