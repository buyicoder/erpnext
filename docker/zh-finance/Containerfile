USER frappe
RUN /home/frappe/frappe-bench/env/bin/python /tmp/merge_frappe_zh_catalog.py \
		--baseline /tmp/frappe-zh-baseline.po \
		--overrides /tmp/frappe-zh-overrides.po \
		--output /home/frappe/frappe-bench/apps/frappe/frappe/locale/zh.po && \
	/home/frappe/frappe-bench/env/bin/python /tmp/merge_erpnext_zh_banking.py \
		--baseline /home/frappe/frappe-bench/apps/erpnext/erpnext/locale/zh.po \
		--translations /tmp/zh_banking.json \
		--output /home/frappe/frappe-bench/apps/erpnext/erpnext/locale/zh.po && \
	cd /home/frappe/frappe-bench && \
	bench compile-po-to-mo --app frappe --locale zh --force && \
	bench compile-po-to-mo --app erpnext --locale zh --force && \
	bench build --app frappe && \
	bench build --app erpnext && \
	/home/frappe/frappe-bench/env/bin/python /tmp/sync_asset_manifest.py \
		--asset-root /home/frappe/frappe-bench/assets \
		--manifest /home/frappe/frappe-bench/assets/assets.json && \
	mkdir -p assets/locale/zh/LC_MESSAGES && \
	cp sites/assets/locale/zh/LC_MESSAGES/frappe.mo assets/locale/zh/LC_MESSAGES/frappe.mo && \
	cp sites/assets/locale/zh/LC_MESSAGES/erpnext.mo assets/locale/zh/LC_MESSAGES/erpnext.mo

# bench build rebuilds ERPNext's bundled Banking app from the pinned upstream
# source. Overlay the localized standalone build afterwards and update both the
# immutable image assets and the sites/assets tree used by existing deployments.
COPY --from=banking-builder --chown=frappe:frappe /erpnext/public/banking /home/frappe/frappe-bench/assets/erpnext/banking
COPY --from=banking-builder --chown=frappe:frappe /erpnext/www/banking.html /home/frappe/frappe-bench/apps/erpnext/erpnext/www/banking.html
